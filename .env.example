# Copy to .env.local and adjust for your machine.

# Where the SQLite database lives. Defaults to data/envis.sqlite
# ENVIS_DB=E:\envis-data\envis.sqlite

# Used by `npm run seed` (add --update to rotate an existing account).
# ENVIS_ADMIN_USERNAME=envisadmin
# ENVIS_ADMIN_EMAIL=geocheckcentralvisayas@gmail.com
# ENVIS_ADMIN_NAME=ENVIS Administrator
# ENVIS_ADMIN_PASSWORD=replace-with-a-long-password
# Or run: npm run seed -- --generate   # prints a secure random password

# Set to 1 only when the site is served over HTTPS. Leave unset for LAN/HTTP,
# otherwise the session cookie is marked Secure and staff cannot sign in.
# ENVIS_HTTPS=1

# Where the publishable MGB geohazard JPEGs live. Point this at a folder that
# contains ONLY those images for public deployments; the default falls back to
# shapefiles/Region VII R7 MGB GEOHAZARDS Jpeg.
# ENVIS_GEOHAZARD_DIR=E:\envis-public\geohazards

# ---------------------------------------------------------------- email
# Outbound email sends the automatic acknowledgement and decision replies.
# Choose a provider preset: gmail | yahoo | outlook | proton | smtp
# ENVIS_MAIL_PROVIDER=gmail
# ENVIS_SMTP_USER=geocheckcentralvisayas@gmail.com
# ENVIS_SMTP_PASS=xxxxxxxxxxxxxxxx
# ENVIS_MAIL_FROM="ENVIS DENR Region VII <geocheckcentralvisayas@gmail.com>"
# ENVIS_MAIL_REPLY_TO=geocheckcentralvisayas@gmail.com

# Provider presets (host/port/encryption are filled in automatically):
#   gmail    smtp.gmail.com:465        Google App Password required
#   yahoo    smtp.mail.yahoo.com:465   Yahoo App Password required
#   outlook  smtp-mail.outlook.com:587 App Password when 2FA is on
#   proton   127.0.0.1:1025            Requires Proton Mail Bridge
#
# Override the preset with an explicit server if needed:
# ENVIS_SMTP_HOST=smtp.example.com
# ENVIS_SMTP_PORT=587
# ENVIS_SMTP_SECURE=0
